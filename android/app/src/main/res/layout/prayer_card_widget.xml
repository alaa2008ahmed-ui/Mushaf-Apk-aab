<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_white"
    android:clipToOutline="true"
    android:padding="8dp">

    <!-- Header: City & Hijri/Gregorian Date -->
    <LinearLayout
        android:id="@+id/widget_card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/widget_card_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Logo" />

        <TextView
            android:id="@+id/widget_card_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الدمام"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/widget_card_date"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="15 جمادى الأولى 1448"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- Center Hero Box: Next Prayer, Countdown, Exact Time -->
    <LinearLayout
        android:id="@+id/widget_card_hero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_bg_rounded"
        android:padding="6dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_card_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صلاة العصر بعد"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_card_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:countDown="true" />

        <TextView
            android:id="@+id/widget_card_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأذان : 03:14"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <!-- Bottom Strip: 6 Prayers Compact -->
    <LinearLayout
        android:id="@+id/widget_card_prayers_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="2dp">

        <!-- Fajr -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/card_name_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فجر" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/card_time_fajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04:25" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <!-- Sunrise -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/card_name_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="شروق" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/card_time_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:45" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <!-- Dhuhr -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/card_name_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ظهر" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/card_time_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11:24" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <!-- Asr -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/card_name_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عصر" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/card_time_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="02:38" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <!-- Maghrib -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/card_name_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مغرب" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/card_time_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:02" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
        <!-- Isha -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/card_name_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عشاء" android:textColor="#0F172A" android:textSize="10sp" android:textStyle="bold"/>
            <TextView android:id="@+id/card_time_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="06:32" android:textColor="#0F172A" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
