<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_white"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:weightSum="3"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Section 1: App Icon & City Name (Exact 1/3 Width) -->
    <LinearLayout
        android:id="@+id/widget_compact_left"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <ImageView
            android:id="@+id/widget_compact_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App Logo" />

        <TextView
            android:id="@+id/widget_compact_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الدمام"
            android:textColor="#334155"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Divider 1 -->
    <FrameLayout
        android:id="@+id/widget_compact_sep1"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Section 2: Next Prayer & Live Countdown (Exact 1/3 Width) -->
    <LinearLayout
        android:id="@+id/widget_compact_center"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <TextView
            android:id="@+id/widget_compact_prayer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="العصر بعد"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center" />

        <Chronometer
            android:id="@+id/widget_compact_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:countDown="true" />
    </LinearLayout>

    <!-- Divider 2 -->
    <FrameLayout
        android:id="@+id/widget_compact_sep2"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Section 3: Exact Prayer Time & Label (Exact 1/3 Width) -->
    <LinearLayout
        android:id="@+id/widget_compact_right"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <TextView
            android:id="@+id/widget_compact_prayer_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الأذان"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center" />

        <TextView
            android:id="@+id/widget_compact_prayer_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="02:38"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:gravity="center"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
