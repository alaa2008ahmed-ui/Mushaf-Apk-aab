<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Holy Quran -->
    <shortcut
        android:shortcutId="shortcut_quran"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_quran"
        android:shortcutShortLabel="@string/shortcut_quran_short"
        android:shortcutLongLabel="@string/shortcut_quran_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.mushaf.ahmedandlayla"
            android:targetClass="com.mushaf.ahmedandlayla.MainActivity"
            android:data="com.mushaf.ahmedandlayla://quran" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

